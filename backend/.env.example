DATABASE_URL=postgresql://naano:naano@localhost:5435/naano
SESSION_SECRET=dev-session-secret-change-me
CORS_ORIGIN=http://localhost:5173
PORT=8080
# Optional — enables LLM tour matching for POST /api/v1/guide (falls back to keywords if unset)
# OPENAI_API_KEY=
# Optional — YouTube Data API v3 key for reliable subscriber counts on creator onboarding
# Free quota from Google Cloud. Without it, public channel page scrape is used as fallback.
# YOUTUBE_API_KEY=
# Required for the Nao AI toolbar (POST /api/v1/ai/chat) — server-only, never expose to the browser
# Also used to structure LinkedIn / website onboarding scrapes when present
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
