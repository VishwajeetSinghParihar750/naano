{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/inject-workflow-state.sh"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/capture-agent-log.sh"
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/capture-agent-log.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-ship.sh",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/guard-decisions.sh",
        "matcher": "Write|StrReplace|Delete",
        "failClosed": false
      }
    ]
  }
}
