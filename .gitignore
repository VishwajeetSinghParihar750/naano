# Logs / coverage (app runtime, not agent capture)
*.log
coverage/
.nyc_output/

# Vite / tooling caches
.vite/
.turbo/

# Prisma
backend/prisma/*.db
backend/prisma/*.db-journal

# NOTE: Do NOT ignore .agent-logs/ — it ships with the repo per assignment rules.
